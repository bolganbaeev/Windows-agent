# Optional. Relative paths are resolved from the exam-controller directory.
DATABASE_PATH=./data/exam-controller.sqlite3
AGENT_TOKEN=dev-agent-token-change-me
# Enable only to exercise the fixed mock command types during development.
ENABLE_TEST_COMMAND_API=false
COMMAND_DELIVERY_TIMEOUT=30
COMMAND_MAX_ATTEMPTS=3

# Explicit lab topology. The Controller is not assumed to have both addresses.
INITIAL_NETWORK=192.168.0.0/24
INITIAL_GATEWAY=192.168.0.1
INITIAL_CONTROLLER_URL=http://192.168.0.10:8000

INTERNAL_NETWORK=192.168.1.0/24
INTERNAL_GATEWAY=192.168.1.1
INTERNAL_CONTROLLER_URL=http://192.168.1.10:8000
# Optional when INTERNAL_CONTROLLER_URL uses a hostname instead of an IPv4 literal.
# INTERNAL_CONTROLLER_IP=192.168.1.10
