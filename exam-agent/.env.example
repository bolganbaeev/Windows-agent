# AGENT_ID=
# Optional persistent identity path; by default it is exam-agent/agent_id.
# AGENT_ID_FILE=C:\ProgramData\ExamAgent\agent_id
# Optional persistent command idempotency database.
# AGENT_COMMAND_DB=C:\ProgramData\ExamAgent\processed_commands.sqlite3
